rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Keep in sync with src/firebase/admins.js and firestore.rules
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['markdesmith@gmail.com', 'actress_erikaretiz@outlook.com'];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
