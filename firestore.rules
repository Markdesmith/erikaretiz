rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep in sync with src/firebase/admins.js and storage.rules
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['markdesmith@gmail.com', 'actress_erikaretiz@outlook.com'];
    }

    match /{document=**} {
      allow read: if true;
    }
    match /siteConfig/{doc} {
      allow write: if isAdmin();
    }
    match /sections/{doc} {
      allow write: if isAdmin();
    }
    match /portfolio/{doc} {
      allow write: if isAdmin();
    }
  }
}
